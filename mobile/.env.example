# Supabase — l'IP du PC sur ton Wi-Fi (PAS 127.0.0.1 qui pointerait sur le tel)
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.77:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# URL du Next.js admin (pour les calls API stripe/create-subscription)
EXPO_PUBLIC_WEB_API_URL=http://192.168.1.77:3000

# Stripe (in-app subscriptions)
# Crée tes Price IDs sur https://dashboard.stripe.com/test/products
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_STRIPE_PRICE_ESSENTIEL=price_xxx
EXPO_PUBLIC_STRIPE_PRICE_FAMILLE=price_xxx
EXPO_PUBLIC_STRIPE_PRICE_PREMIUM=price_xxx
